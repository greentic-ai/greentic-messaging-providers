{
  "id": "messaging-provider-telegram",
  "version": "0.4.84",
  "supports": [
    "messaging"
  ],
  "world": "root:component/root",
  "profiles": {
    "default": "default",
    "supported": [
      "default"
    ]
  },
  "capabilities": {
    "wasi": {},
    "host": {}
  },
  "operations": [
    {
      "name": "qa-spec",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded QA specification",
        "additionalProperties": true,
        "properties": {
          "questions": {
            "type": "array",
            "description": "List of questions in the QA spec"
          }
        }
      }
    },
    {
      "name": "apply-answers",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          },
          "answers_cbor": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "CBOR-encoded answers"
          }
        },
        "required": [
          "mode",
          "answers_cbor"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded result with config and optional cleanup plan",
        "additionalProperties": true,
        "properties": {
          "config": {
            "type": "object",
            "description": "Provider configuration"
          }
        }
      }
    }
  ],
  "resources": {},
  "dev_flows": {}
}
