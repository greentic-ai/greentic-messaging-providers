{
  "id": "messaging-provider-email",
  "name": "messaging-provider-email",
  "version": "0.4.84",
  "world": "greentic:component/component-v0-v6-v0@0.6.1",
  "description": "Provider-core SMTP email sender (simulated).",
  "profiles": {
    "default": "default",
    "supported": [
      "default"
    ]
  },
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/email/public.config.schema.json"
    }
  },
  "secret_requirements": [
    {
      "name": "EMAIL_PASSWORD",
      "scope": "tenant",
      "description": "SMTP password secret key"
    }
  ],
  "operations": [
    {
      "name": "qa-spec",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded QA specification",
        "additionalProperties": true,
        "properties": {
          "questions": {
            "type": "array",
            "description": "List of questions in the QA spec"
          }
        }
      }
    },
    {
      "name": "apply-answers",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          },
          "answers_cbor": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "CBOR-encoded answers"
          }
        },
        "required": [
          "mode",
          "answers_cbor"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded result with config and optional cleanup plan",
        "additionalProperties": true,
        "properties": {
          "config": {
            "type": "object",
            "description": "Provider configuration"
          }
        }
      }
    }
  ],
  "capabilities": {
    "wasi": {},
    "host": {}
  }
}
