  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/webchat/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.4.84",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-webchat-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-webchat",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-webchat"
            },
            "version": "0.4.84"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.http-routes.v1": {
      "kind": "greentic.http-routes.v1",
      "version": "0.4.84",
      "inline": {
        "routes": [
          {
            "domain": "messaging",
            "id": "webchat-auth-config",
            "methods": [
              "GET"
            ],
            "pattern": "/v1/messaging/webchat/{tenant}/auth/config",
            "provider_op": "ingest_http"
          },
          {
            "domain": "messaging",
            "id": "webchat-token",
            "methods": [
              "GET",
              "POST"
            ],
            "pattern": "/v1/messaging/webchat/{tenant}/token",
            "provider_op": "ingest_http"
          },
          {
            "domain": "messaging",
            "id": "webchat-directline",
            "methods": [],
            "pattern": "/v1/messaging/webchat/{tenant}/v3/directline/{path*}",
            "provider_op": "ingest_http"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.4.84",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.4.84",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.webchat",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "ingest",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/webchat/public.config.schema.json",
            "runtime": {
              "component_ref": "messaging-provider-webchat",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.4.84",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": false
        },
        "component_ref": "messaging-provider-webchat",
        "export": "ingest-http",
        "world": "greentic:provider/schema-core@1.0.0"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-provider-webchat",
        "kind": "ingress-egress",
        "name": "messaging.webchat"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "WEBCHAT_TOKEN",
      "scope": "tenant",
      "description": "Optional token used for webchat setup validation and conformance checks."
    }
  ],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
